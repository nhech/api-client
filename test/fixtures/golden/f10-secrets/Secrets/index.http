### basic
# @name basic
GET {{base}}/b
Authorization: Basic user {{secret_secrets_basic_password}}

### bearer
# @name bearer
GET {{base}}/a
Authorization: Bearer {{secret_secrets_bearer_token}}

### form
# @name form
POST {{base}}/e
Content-Type: application/x-www-form-urlencoded

user=me&password={{secret_secrets_form_password}}

### graphql body
# @name graphql_body
POST {{base}}/h
Content-Type: application/json

{
  "query": "mutation { login(user: \"me\", password: \"{{secret_secrets_body_password}}\") { ok } }",
  "variables": {
    "token": "{{secret_secrets_body_token}}"
  }
}

### headers
# @name headers
# [disabled] X-Old-Key: {{secret_secrets_header_x_old_key}}
GET {{base}}/c
Authorization: Bearer {{secret_secrets_header_authorization}}
X-Api-Key: {{secret_secrets_header_x_api_key}}
X-Trace: trace-1

### json body
# @name json_body
POST {{base}}/f
Content-Type: application/json

{"user":"me","apiKey":"{{secret_secrets_body_apikey}}"}

### path parameter
# @name path_parameter
GET {{base}}/k/{{secret_secrets_pathparam_apikey}}

### query
# @name query
GET {{base}}/d?api_key={{secret_secrets_query_api_key}}&page=1

### text body
# @name text_body
POST {{base}}/i
Content-Type: text/plain

grant_type=password&client_secret={{secret_secrets_body_client_secret}}

### url fragment
# @name url_fragment
GET {{base}}/l#access_token={{secret_secrets_fragment_access_token}}&state=1

### url token userinfo
# @name url_token_userinfo
GET https://{{secret_secrets_userinfo_token}}@example.com/j2

### url userinfo
# @name url_userinfo
GET https://user:{{secret_secrets_userinfo_password}}@example.com/j

### xml body
# @name xml_body
POST {{base}}/g
Content-Type: application/xml

<login><name>me</name><Password>{{secret_secrets_body_password_2}}</Password></login>
