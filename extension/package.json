          "group": "2_open@1"
        },
        {
          "command": "apiClient.revealInExplorer",
          "when": "view == apiClient.environments",
          "group": "9_manage@1"
        },
        {
          "command": "apiClient.history.openRequest",
          "when": "view == apiClient.history && viewItem == historyEntry",
          "group": "inline@1"
        },
        {
          "command": "apiClient.history.remove",
          "when": "view == apiClient.history && viewItem == historyEntry",
          "group": "inline@2"
        },
        {
          "command": "apiClient.history.open",
          "when": "view == apiClient.history && viewItem == historyEntry",
          "group": "1_open@1"
        },
        {
          "command": "apiClient.history.openRequest",
          "when": "view == apiClient.history && viewItem == historyEntry",
          "group": "1_open@2"
        },
        {
          "command": "apiClient.history.remove",
          "when": "view == apiClient.history && viewItem == historyEntry",
          "group": "9_manage@1"
        },
        {
          "command": "apiClient.rename",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request)$/",
          "group": "3_modify@1"
        },
        {
          "command": "apiClient.duplicate",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request)$/",
          "group": "3_modify@2"
        },
        {
          "command": "apiClient.moveTo",
          "when": "view == apiClient.collections && viewItem =~ /^(folder|request)$/",
          "group": "3_modify@3"
        },
        {
          "command": "apiClient.delete",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request)$/",
          "group": "3_modify@9"
        },
        {
          "command": "apiClient.rename",
          "when": "view == apiClient.environments && viewItem =~ /^environment/",
          "group": "3_modify@1"
        },
        {
          "command": "apiClient.duplicate",
          "when": "view == apiClient.environments && viewItem =~ /^environment/",
          "group": "3_modify@2"
        },
        {
          "command": "apiClient.delete",
          "when": "view == apiClient.environments && viewItem =~ /^environment/",
          "group": "3_modify@9"
        },
        {
          "command": "apiClient.openSettings",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "inline@1"
        },
        {
          "command": "apiClient.openSettings",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "2_open@1"
        }
      ]
    },
    "configuration": {
      "title": "API Client",
      "properties": {
        "apiClient.mirror.mode": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "gitignored"
          ],
          "enumDescriptions": [
            "Write a .http file next to each request, and keep it in step with the request.",
            "Write no .http files.",
            "Write the .http files but keep them out of Git (they are listed in a block of the .gitignore of the client folder)."
          ],
          "default": "on",
          "scope": "resource",
          "markdownDescription": "The `.http` file that is written next to each request, for people who use the files with REST Client, JetBrains or httpYac, or read them in a pull request. The request is the source: a `.http` file that you edit is never written over."
        },
        "apiClient.history.mode": {
          "type": "string",
          "enum": [
            "metadata",
            "full",
            "off"
          ],
          "enumDescriptions": [
            "Keep a line for each request you send: the method, the address, the status, the time and the size.",
            "Keep the line, the headers and the first 64 KB of the two bodies as well. Secrets that the request was built from, and fields and headers that are named like secrets, are covered, but a token that a server sends back cannot be known.",
            "Keep nothing."
          ],
          "default": "metadata",
          "scope": "machine",
          "markdownDescription": "What the History view keeps about the requests you send. It is kept on this computer, for this workspace only (never in the files of the collection, so it is not committed), at most 200 entries for 30 days."
        },
        "apiClient.scripts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Run the scripts of requests, folders and collections, after you have allowed them. Turn it off to send requests without ever running a script."
        },
        "apiClient.root": {
          "type": "string",
          "default": "api-client",
          "scope": "resource",
          "markdownDescription": "The folder of the workspace where the collections, the environments and the settings of the client are kept, as plain files."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "apiClient.request",
        "displayName": "API Client Request",
        "selector": [
          {
            "filenamePattern": "*.req.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "apiClient.environment",
        "displayName": "API Client Environment",
        "selector": [
          {
            "filenamePattern": "*.env.yml"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "apiClient.container",
        "displayName": "API Client Collection or Folder",
        "selector": [
          {
            "filenamePattern": "collection.yml"
          },
          {
            "filenamePattern": "folder.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "apiClient.rename",
        "key": "f2",
        "when": "focusedView == apiClient.collections || focusedView == apiClient.environments"
      },
      {
        "command": "apiClient.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == apiClient.collections || focusedView == apiClient.environments"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "package": "node -e \"require('node:fs').mkdirSync('../.artifacts',{recursive:true})\" && node esbuild.mjs --release && vsce package --no-dependencies --out ../.artifacts/api-client.vsix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhech/api-client.git"
  },
  "bugs": {
    "url": "https://github.com/nhech/api-client/issues"
  },
  "homepage": "https://github.com/nhech/api-client#readme"
}
