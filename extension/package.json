      {
        "command": "apiClient.clearVariables",
        "title": "Clear Saved Variables",
        "category": "API Client"
      },
      {
        "command": "apiClient.history.open",
        "title": "Open",
        "category": "API Client"
      },
      {
        "command": "apiClient.history.openRequest",
        "title": "Open the Request",
        "category": "API Client",
        "icon": "$(go-to-file)"
      },
      {
        "command": "apiClient.history.remove",
        "title": "Remove from History",
        "category": "API Client",
        "icon": "$(close)"
      },
      {
        "command": "apiClient.history.clear",
        "title": "Clear History",
        "category": "API Client",
        "icon": "$(clear-all)"
      },
      {
