{
  "name": "api-client",
  "displayName": "API Client",
  "description": "A free, local-first API client for VS Code, in development. Today it imports Thunder Client collections and environments into plain .http files for REST Client, httpYac and the JetBrains HTTP Client. No account, no telemetry.",
  "version": "0.1.0",
  "publisher": "longtd",
  "license": "MIT",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "thunder client",
    "thunder-client",
    "import",
    "migrate",
    "migration",
    "convert",
    "http",
    ".http",
    "rest client",
    "httpyac",
    "jetbrains",
    "http client",
    "api",
    "collections",
    "environments"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/api-client/workspace.yml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Importing and creating write files into the workspace, collections come from other people, and their scripts run on this computer, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The imported files are written with the file system of the machine the extension runs on."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "apiClient.newRequest",
        "title": "New Request...",
        "category": "API Client",
        "icon": "$(add)"
      },
      {
        "command": "apiClient.newFolder",
        "title": "New Folder...",
        "category": "API Client",
        "icon": "$(new-folder)"
      },
      {
        "command": "apiClient.newCollection",
        "title": "New Collection...",
        "category": "API Client",
        "icon": "$(library)"
      },
      {
        "command": "apiClient.newEnvironment",
        "title": "New Environment...",
        "category": "API Client",
        "icon": "$(add)"
      },
      {
        "command": "apiClient.setEnvironment",
        "title": "Change Environment...",
        "category": "API Client",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "apiClient.filter",
        "title": "Filter Requests...",
        "category": "API Client",
        "icon": "$(filter)"
      },
      {
        "command": "apiClient.clearFilter",
        "title": "Clear Filter",
        "category": "API Client",
        "icon": "$(clear-all)"
      },
      {
        "command": "apiClient.refresh",
        "title": "Refresh",
        "category": "API Client",
        "icon": "$(refresh)"
      },
      {
        "command": "apiClient.openRequest",
        "title": "Open Request",
        "category": "API Client"
      },
      {
        "command": "apiClient.openAsText",
        "title": "Open as Text",
        "category": "API Client"
      },
      {
        "command": "apiClient.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "API Client"
      },
      {
        "command": "apiClient.import",
        "title": "Import...",
        "category": "API Client",
        "icon": "$(cloud-download)"
      },
      {
        "command": "apiClient.importThunderData",
        "title": "Import Thunder Client Data...",
        "category": "API Client"
      },
      {
        "command": "apiClient.importPostman",
        "title": "Import a Postman Collection or Environment...",
        "category": "API Client"
      },
      {
        "command": "apiClient.importCurl",
        "title": "New Request from cURL...",
        "category": "API Client"
      },
      {
        "command": "apiClient.importNotes",
        "title": "Show the Notes of the Last Import",
        "category": "API Client"
      },
      {
        "command": "apiClient.importThunder",
        "title": "Convert Thunder Client Data to .http Files...",
        "category": "API Client"
      },
      {
        "command": "apiClient.importThunderSteps",
        "title": "Convert Thunder Client Data to .http Files (step by step)...",
        "category": "API Client"
      },
      {
        "command": "apiClient.rename",
        "title": "Rename...",
        "category": "API Client"
      },
      {
        "command": "apiClient.duplicate",
        "title": "Duplicate",
        "category": "API Client"
      },
      {
        "command": "apiClient.delete",
        "title": "Delete...",
        "category": "API Client"
      },
      {
        "command": "apiClient.moveTo",
        "title": "Move to...",
