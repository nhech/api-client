        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.detach",
        "title": "Keep This .http File as My Own",
        "category": "API Client"
      }
    ],
    "views": {
      "apiClient": [
        {
          "id": "apiClient.collections",
          "name": "Collections"
        },
        {
          "id": "apiClient.environments",
          "name": "Environments"
        },
        {
          "id": "apiClient.history",
          "name": "History",
          "visibility": "collapsed"
        }
      ],
      "explorer": [
        {
          "id": "apiClient.start",
          "name": "API Client",
          "visibility": "collapsed",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apiClient.collections",
        "contents": "Open a folder to keep your requests in it, as plain files that Git can track.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "apiClient.collections",
        "contents": "No collections yet. A collection is a folder of requests with what they share: a base address, headers, authentication.\n[New Collection](command:apiClient.newCollection)\n[Import...](command:apiClient.import)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "apiClient.environments",
        "contents": "An environment holds variables such as the address of a server, for {{name}} in your requests.\n[New Environment](command:apiClient.newEnvironment)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "apiClient.history",
        "contents": "The requests you send appear here. Only the line is kept (the method, the address, the status and the time): headers and bodies are kept only if you choose so in the setting apiClient.history.mode.",
        "when": "config.apiClient.history.mode != off"
      },
      {
        "view": "apiClient.history",
        "contents": "The history is turned off, so nothing you send is written down.\n[Change the setting](command:workbench.action.openSettings?%5B%22apiClient.history.mode%22%5D)",
        "when": "config.apiClient.history.mode == off"
      },
      {
        "view": "apiClient.start",
        "contents": "Move your Thunder Client collections and environments to plain .http files.\n[Open the importer](command:apiClient.importThunder)\nNothing is written until you press Import. Local only: no account, no network, no telemetry."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiClient",
          "title": "API Client",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "apiClient.history.open",
          "when": "false"
        },
        {
          "command": "apiClient.history.openRequest",
          "when": "false"
        },
        {
          "command": "apiClient.history.remove",
          "when": "false"
        },
        {
          "command": "apiClient.openMirror",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.openRequest",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.showDifferences",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.importEdits",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.discardEdits",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.detach",
          "when": "false"
        },
        {
          "command": "apiClient.openRequest",
          "when": "false"
        },
        {
          "command": "apiClient.openAsText",
          "when": "false"
        },
        {
          "command": "apiClient.revealInExplorer",
          "when": "false"
        },
        {
          "command": "apiClient.clearFilter",
          "when": "apiClient.filtering"
        },
        {
          "command": "apiClient.rename",
          "when": "false"
        },
        {
          "command": "apiClient.duplicate",
          "when": "false"
        },
        {
          "command": "apiClient.delete",
          "when": "false"
        },
        {
          "command": "apiClient.moveTo",
          "when": "false"
        },
        {
          "command": "apiClient.openEnvironment",
          "when": "false"
        },
        {
          "command": "apiClient.openSettings",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "apiClient.newRequest",
          "when": "view == apiClient.collections",
          "group": "navigation@1"
        },
        {
          "command": "apiClient.newCollection",
          "when": "view == apiClient.collections",
          "group": "navigation@2"
        },
        {
          "command": "apiClient.filter",
          "when": "view == apiClient.collections && !apiClient.filtering",
          "group": "navigation@3"
        },
        {
          "command": "apiClient.clearFilter",
          "when": "view == apiClient.collections && apiClient.filtering",
          "group": "navigation@3"
        },
        {
          "command": "apiClient.refresh",
          "when": "view == apiClient.collections",
          "group": "navigation@4"
        },
        {
          "command": "apiClient.import",
          "when": "view == apiClient.collections",
          "group": "navigation@5"
        },
        {
          "command": "apiClient.importCurl",
          "when": "view == apiClient.collections",
          "group": "1_import@1"
        },
        {
          "command": "apiClient.importPostman",
          "when": "view == apiClient.collections",
          "group": "1_import@2"
        },
        {
