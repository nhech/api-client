          "group": "1_create@1"
        },
        {
          "command": "apiClient.newFolder",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "1_create@2"
        },
        {
          "command": "apiClient.runCollection",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "1_create@3"
        },
        {
          "command": "apiClient.openAsText",
          "when": "view == apiClient.collections && viewItem =~ /^(request|broken)$/",
          "group": "2_open@1"
        },
        {
