{
  "name": "api-client",
  "displayName": "API Client",
  "description": "A free, local-first API client for VS Code, in development. Today it imports Thunder Client collections and environments into plain .http files for REST Client, httpYac and the JetBrains HTTP Client. No account, no telemetry.",
  "version": "0.1.0",
  "publisher": "longtd",
  "license": "MIT",
  "preview": true,
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "thunder client",
    "thunder-client",
    "import",
    "migrate",
    "migration",
    "convert",
    "http",
    ".http",
    "rest client",
    "httpyac",
    "jetbrains",
    "http client",
    "api",
    "collections",
    "environments"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:**/api-client/workspace.yml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Importing and creating write files into the workspace, collections come from other people, and their scripts run on this computer, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The imported files are written with the file system of the machine the extension runs on."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "apiClient.newRequest",
        "title": "New Request...",
        "category": "API Client",
        "icon": "$(add)"
      },
      {
        "command": "apiClient.newFolder",
        "title": "New Folder...",
        "category": "API Client",
        "icon": "$(new-folder)"
      },
      {
        "command": "apiClient.newCollection",
        "title": "New Collection...",
        "category": "API Client",
        "icon": "$(library)"
      },
      {
        "command": "apiClient.newEnvironment",
        "title": "New Environment...",
        "category": "API Client",
        "icon": "$(add)"
      },
      {
        "command": "apiClient.setEnvironment",
        "title": "Change Environment...",
        "category": "API Client",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "apiClient.filter",
        "title": "Filter Requests...",
        "category": "API Client",
        "icon": "$(filter)"
      },
      {
        "command": "apiClient.clearFilter",
        "title": "Clear Filter",
        "category": "API Client",
        "icon": "$(clear-all)"
      },
      {
        "command": "apiClient.refresh",
        "title": "Refresh",
        "category": "API Client",
        "icon": "$(refresh)"
      },
      {
        "command": "apiClient.openRequest",
        "title": "Open Request",
        "category": "API Client"
      },
      {
        "command": "apiClient.openAsText",
        "title": "Open as Text",
        "category": "API Client"
      },
      {
        "command": "apiClient.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "API Client"
      },
      {
        "command": "apiClient.importThunder",
        "title": "Import from Thunder Client...",
        "category": "API Client"
      },
      {
        "command": "apiClient.importThunderSteps",
        "title": "Import from Thunder Client (step by step)...",
        "category": "API Client"
      },
      {
        "command": "apiClient.rename",
        "title": "Rename...",
        "category": "API Client"
      },
      {
        "command": "apiClient.duplicate",
        "title": "Duplicate",
        "category": "API Client"
      },
      {
        "command": "apiClient.delete",
        "title": "Delete...",
        "category": "API Client"
      },
      {
        "command": "apiClient.moveTo",
        "title": "Move to...",
        "category": "API Client"
      },
      {
        "command": "apiClient.openEnvironment",
        "title": "Open Environment",
        "category": "API Client"
      },
      {
        "command": "apiClient.openSettings",
        "title": "Collection or Folder Settings",
        "category": "API Client",
        "icon": "$(gear)"
      },
      {
        "command": "apiClient.clearVariables",
        "title": "Clear Saved Variables",
        "category": "API Client"
      },
      {
        "command": "apiClient.cookies",
        "title": "Show Cookies",
        "category": "API Client"
      },
      {
        "command": "apiClient.clearCookies",
        "title": "Delete All Cookies",
        "category": "API Client"
      },
      {
        "command": "apiClient.runCollection",
        "title": "Run Collection or Folder",
        "category": "API Client"
      },
      {
        "command": "apiClient.forgetTokens",
        "title": "Forget Access Tokens and Allowed Token Servers",
        "category": "API Client"
      },
      {
        "command": "apiClient.forgetScripts",
        "title": "Forget Which Scripts Were Allowed",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.syncNow",
        "title": "Write the .http Files Now",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.list",
        "title": "Show the .http Files That Were Edited by Hand",
        "category": "API Client"
      },
      {
        "command": "apiClient.openMirror",
        "title": "Open the .http File",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.openRequest",
        "title": "Open the Request of This .http File",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.showDifferences",
        "title": "Show How This .http File Differs From Its Request",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.importEdits",
        "title": "Take the Edits of This .http File Into Its Request",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.discardEdits",
        "title": "Discard the Edits of This .http File",
        "category": "API Client"
      },
      {
        "command": "apiClient.mirror.detach",
        "title": "Keep This .http File as My Own",
        "category": "API Client"
      }
    ],
    "views": {
      "apiClient": [
        {
          "id": "apiClient.collections",
          "name": "Collections"
        },
        {
          "id": "apiClient.environments",
          "name": "Environments"
        },
        {
          "id": "apiClient.history",
          "name": "History",
          "visibility": "collapsed"
        }
      ],
      "explorer": [
        {
          "id": "apiClient.start",
          "name": "API Client",
          "visibility": "collapsed",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "apiClient.collections",
        "contents": "Open a folder to keep your requests in it, as plain files that Git can track.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "apiClient.collections",
        "contents": "No collections yet. A collection is a folder of requests with what they share: a base address, headers, authentication.\n[New Collection](command:apiClient.newCollection)\n[Import from Thunder Client](command:apiClient.importThunder)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "apiClient.environments",
        "contents": "An environment holds variables such as the address of a server, for {{name}} in your requests.\n[New Environment](command:apiClient.newEnvironment)",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "apiClient.history",
        "contents": "The requests you send appear here."
      },
      {
        "view": "apiClient.start",
        "contents": "Move your Thunder Client collections and environments to plain .http files.\n[Open the importer](command:apiClient.importThunder)\nNothing is written until you press Import. Local only: no account, no network, no telemetry."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apiClient",
          "title": "API Client",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "apiClient.openMirror",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.openRequest",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.showDifferences",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.importEdits",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.discardEdits",
          "when": "false"
        },
        {
          "command": "apiClient.mirror.detach",
          "when": "false"
        },
        {
          "command": "apiClient.openRequest",
          "when": "false"
        },
        {
          "command": "apiClient.openAsText",
          "when": "false"
        },
        {
          "command": "apiClient.revealInExplorer",
          "when": "false"
        },
        {
          "command": "apiClient.clearFilter",
          "when": "apiClient.filtering"
        },
        {
          "command": "apiClient.rename",
          "when": "false"
        },
        {
          "command": "apiClient.duplicate",
          "when": "false"
        },
        {
          "command": "apiClient.delete",
          "when": "false"
        },
        {
          "command": "apiClient.moveTo",
          "when": "false"
        },
        {
          "command": "apiClient.openEnvironment",
          "when": "false"
        },
        {
          "command": "apiClient.openSettings",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "apiClient.newRequest",
          "when": "view == apiClient.collections",
          "group": "navigation@1"
        },
        {
          "command": "apiClient.newCollection",
          "when": "view == apiClient.collections",
          "group": "navigation@2"
        },
        {
          "command": "apiClient.filter",
          "when": "view == apiClient.collections && !apiClient.filtering",
          "group": "navigation@3"
        },
        {
          "command": "apiClient.clearFilter",
          "when": "view == apiClient.collections && apiClient.filtering",
          "group": "navigation@3"
        },
        {
          "command": "apiClient.refresh",
          "when": "view == apiClient.collections",
          "group": "navigation@4"
        },
        {
          "command": "apiClient.importThunder",
          "when": "view == apiClient.collections",
          "group": "1_import"
        },
        {
          "command": "apiClient.newEnvironment",
          "when": "view == apiClient.environments",
          "group": "navigation@1"
        },
        {
          "command": "apiClient.refresh",
          "when": "view == apiClient.environments",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "apiClient.newRequest",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "1_create@1"
        },
        {
          "command": "apiClient.newFolder",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "1_create@2"
        },
        {
          "command": "apiClient.runCollection",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "1_create@3"
        },
        {
          "command": "apiClient.openAsText",
          "when": "view == apiClient.collections && viewItem =~ /^(request|broken)$/",
          "group": "2_open@1"
        },
        {
          "command": "apiClient.openMirror",
          "when": "view == apiClient.collections && viewItem == request",
          "group": "2_open@2"
        },
        {
          "command": "apiClient.revealInExplorer",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request|broken)$/",
          "group": "9_manage@1"
        },
        {
          "command": "apiClient.setEnvironment",
          "when": "view == apiClient.environments && viewItem == environment",
          "group": "inline"
        },
        {
          "command": "apiClient.setEnvironment",
          "when": "view == apiClient.environments && viewItem == environment",
          "group": "1_active@1"
        },
        {
          "command": "apiClient.openAsText",
          "when": "view == apiClient.environments && viewItem =~ /^(environment|environment.active|broken)$/",
          "group": "2_open@1"
        },
        {
          "command": "apiClient.revealInExplorer",
          "when": "view == apiClient.environments",
          "group": "9_manage@1"
        },
        {
          "command": "apiClient.rename",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request)$/",
          "group": "3_modify@1"
        },
        {
          "command": "apiClient.duplicate",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request)$/",
          "group": "3_modify@2"
        },
        {
          "command": "apiClient.moveTo",
          "when": "view == apiClient.collections && viewItem =~ /^(folder|request)$/",
          "group": "3_modify@3"
        },
        {
          "command": "apiClient.delete",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder|request)$/",
          "group": "3_modify@9"
        },
        {
          "command": "apiClient.rename",
          "when": "view == apiClient.environments && viewItem =~ /^environment/",
          "group": "3_modify@1"
        },
        {
          "command": "apiClient.duplicate",
          "when": "view == apiClient.environments && viewItem =~ /^environment/",
          "group": "3_modify@2"
        },
        {
          "command": "apiClient.delete",
          "when": "view == apiClient.environments && viewItem =~ /^environment/",
          "group": "3_modify@9"
        },
        {
          "command": "apiClient.openSettings",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "inline@1"
        },
        {
          "command": "apiClient.openSettings",
          "when": "view == apiClient.collections && viewItem =~ /^(collection|folder)$/",
          "group": "2_open@1"
        }
      ]
    },
    "configuration": {
      "title": "API Client",
      "properties": {
        "apiClient.mirror.mode": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "gitignored"
          ],
          "enumDescriptions": [
            "Write a .http file next to each request, and keep it in step with the request.",
            "Write no .http files.",
            "Write the .http files but keep them out of Git (they are listed in a block of the .gitignore of the client folder)."
          ],
          "default": "on",
          "scope": "resource",
          "markdownDescription": "The `.http` file that is written next to each request, for people who use the files with REST Client, JetBrains or httpYac, or read them in a pull request. The request is the source: a `.http` file that you edit is never written over."
        },
        "apiClient.scripts.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Run the scripts of requests, folders and collections, after you have allowed them. Turn it off to send requests without ever running a script."
        },
        "apiClient.root": {
          "type": "string",
          "default": "api-client",
          "scope": "resource",
          "markdownDescription": "The folder of the workspace where the collections, the environments and the settings of the client are kept, as plain files."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "apiClient.request",
        "displayName": "API Client Request",
        "selector": [
          {
            "filenamePattern": "*.req.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "apiClient.environment",
        "displayName": "API Client Environment",
        "selector": [
          {
            "filenamePattern": "*.env.yml"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "apiClient.container",
        "displayName": "API Client Collection or Folder",
        "selector": [
          {
            "filenamePattern": "collection.yml"
          },
          {
            "filenamePattern": "folder.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "apiClient.rename",
        "key": "f2",
        "when": "focusedView == apiClient.collections || focusedView == apiClient.environments"
      },
      {
        "command": "apiClient.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == apiClient.collections || focusedView == apiClient.environments"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "package": "node -e \"require('node:fs').mkdirSync('../.artifacts',{recursive:true})\" && node esbuild.mjs --release && vsce package --no-dependencies --out ../.artifacts/api-client.vsix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhech/api-client.git"
  },
  "bugs": {
    "url": "https://github.com/nhech/api-client/issues"
  },
  "homepage": "https://github.com/nhech/api-client#readme"
}
