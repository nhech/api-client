          "group": "navigation@1"
        },
        {
          "command": "apiClient.refresh",
          "when": "view == apiClient.environments",
          "group": "navigation@2"
        },
        {
          "command": "apiClient.history.clear",
          "when": "view == apiClient.history",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
